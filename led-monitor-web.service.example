[Unit]
Description=LED Monitor Status Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/path/to/pimonitor
ExecStart=/path/to/pimonitor/venv/bin/python status-web.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

