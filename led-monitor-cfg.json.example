{
  "check_interval": 30,
  "led_count": 10,
  "internet_probe": {
    "type": "ping",
    "target": "1.1.1.1",
    "timeout": 3,
    "comment": "Internet connectivity via Cloudflare DNS (1.1.1.1)"
  },
  "services": [
    {
      "name": "internet",
      "type": "ping",
      "target": "8.8.8.8",
      "severity": 5,
      "comment": "Internet connectivity check"
    },
    {
      "name": "pihole",
      "type": "http",
      "target": "http://localhost/admin/api.php",
      "severity": 3,
      "comment": "[Service] Pi-hole - DNS ad blocker web interface"
    },
    {
      "name": "tailscale",
      "type": "systemd",
      "target": "tailscaled",
      "severity": 7,
      "comment": "Tailscale VPN service"
    },
    {
      "name": "example-service",
      "type": "http",
      "target": "http://localhost:8080/health",
      "severity": 5,
      "comment": "[Service] Example HTTP service - Health check endpoint"
    },
    {
      "name": "example-tcp",
      "type": "tcp",
      "target": "localhost:22",
      "severity": 4,
      "comment": "[Service] SSH - Secure shell access (TCP port 22)"
    },
    {
      "name": "example-insecure",
      "type": "http_insecure",
      "target": "https://192.168.1.1/",
      "severity": 6,
      "comment": "[Router] Router web interface - Self-signed certificate"
    },
    {
      "name": "example-nas",
      "type": "http",
      "target": "http://nas.local/ui/dashboard",
      "severity": 10,
      "comment": "[NAS] TrueNAS - Storage system web interface"
    },
    {
      "name": "example-tailnet",
      "type": "ping",
      "target": "machine.example.ts.net",
      "severity": 5,
      "comment": "[Tailnet Machine] Physical computer - Tailscale network connectivity"
    }
  ]
}

